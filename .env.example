POSTGRES_PASSWORD=campus
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://campus:campus@127.0.0.1:5432/campus

# Use a URL-safe database password and update both fields for deployments.
PUBLIC_ORIGIN=https://localhost:8443
CAMPUS_HOST=localhost
CAMPUS_BIND=127.0.0.1
CAMPUS_PORT=8443
TLS_FINGERPRINT_SHA256=

LLM_PROVIDER=disabled
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_JSON_MODE=json_object

# Optional, absolute path inside the coordinator container.
CATALOG_FILE=
