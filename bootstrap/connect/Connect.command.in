#!/bin/sh
set -eu
umask 077
fail() { printf '%s\n' "Campus: $1" >&2; exit 1; }
bundle=$(CDPATH= cd -P "$(dirname "$0")" && pwd)
cd "$bundle"
PATH="/usr/local/bin:$HOME/.docker/bin:/Applications/Docker.app/Contents/Resources/bin:$PATH"
export PATH
[ ! -L ./campus ] && [ -f ./campus ] || fail 'runner must be a regular file'
[ ! -L ./connection.json ] && [ -f ./connection.json ] || fail 'connection manifest must be a regular file'
actual=$(shasum -a 256 < ./campus) || fail 'cannot verify runner'
[ "${actual%% *}" = '@RUNNER_SHA256@' ] || fail 'runner checksum mismatch; obtain a fresh trusted package'
actual=$(shasum -a 256 < ./connection.json) || fail 'cannot verify connection manifest'
[ "${actual%% *}" = '@MANIFEST_SHA256@' ] || fail 'connection manifest checksum mismatch; obtain a fresh trusted package'
chmod u+x ./campus
exec "$bundle/campus" connect --bundle "$bundle" --manifest-sha256 '@MANIFEST_SHA256@' "$@"
