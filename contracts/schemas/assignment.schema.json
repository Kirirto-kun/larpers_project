{
  "$defs": {
    "AdapterRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "AdapterRef",
      "type": "object"
    },
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "media_type": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "name": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 9.223372036854776e+18,
          "minimum": 0.0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "size_bytes",
        "sha256",
        "media_type"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "Assignment": {
      "additionalProperties": false,
      "properties": {
        "accelerator": {
          "enum": [
            "cpu",
            "cuda"
          ],
          "title": "Accelerator",
          "type": "string"
        },
        "adapter": {
          "$ref": "#/$defs/AdapterRef"
        },
        "argv": {
          "items": {
            "type": "string"
          },
          "title": "Argv",
          "type": "array"
        },
        "attempt_id": {
          "format": "uuid",
          "title": "Attempt Id",
          "type": "string"
        },
        "checkpoint_compatibility_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Checkpoint Compatibility Digest"
        },
        "generation": {
          "exclusiveMinimum": 0.0,
          "maximum": 9.223372036854776e+18,
          "title": "Generation",
          "type": "integer"
        },
        "heartbeat_interval_ms": {
          "exclusiveMinimum": 0.0,
          "maximum": 9.223372036854776e+18,
          "title": "Heartbeat Interval Ms",
          "type": "integer"
        },
        "image_digest": {
          "maxLength": 256,
          "pattern": "^[a-z0-9][a-z0-9./:_-]*@sha256:[a-f0-9]{64}$",
          "title": "Image Digest",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/AssignmentInput"
          },
          "title": "Inputs",
          "type": "array"
        },
        "item_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "title": "Item Ids",
          "type": "array"
        },
        "job_id": {
          "format": "uuid",
          "title": "Job Id",
          "type": "string"
        },
        "lease_expires_at": {
          "format": "date-time",
          "title": "Lease Expires At",
          "type": "string"
        },
        "lease_remaining_ms": {
          "maximum": 9.223372036854776e+18,
          "minimum": 0.0,
          "title": "Lease Remaining Ms",
          "type": "integer"
        },
        "lease_token": {
          "maxLength": 128,
          "minLength": 32,
          "title": "Lease Token",
          "type": "string"
        },
        "manifest_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Manifest Digest",
          "type": "string"
        },
        "network_policy": {
          "const": "none",
          "title": "Network Policy",
          "type": "string"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/Output"
          },
          "title": "Outputs",
          "type": "array"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "platform": {
          "title": "Platform",
          "type": "string"
        },
        "resource_limits": {
          "$ref": "#/$defs/Resources"
        },
        "resume_checkpoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/Artifact"
            },
            {
              "type": "null"
            }
          ]
        },
        "stage_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$",
          "title": "Stage Id",
          "type": "string"
        },
        "task_deadline_at": {
          "format": "date-time",
          "title": "Task Deadline At",
          "type": "string"
        },
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "validator_policy": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$",
          "title": "Validator Policy",
          "type": "string"
        },
        "variant_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$",
          "title": "Variant Id",
          "type": "string"
        },
        "working_dir": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Working Dir",
          "type": "string"
        }
      },
      "required": [
        "generation",
        "lease_token",
        "job_id",
        "stage_id",
        "task_id",
        "attempt_id",
        "variant_id",
        "lease_expires_at",
        "lease_remaining_ms",
        "heartbeat_interval_ms",
        "task_deadline_at",
        "manifest_digest",
        "adapter",
        "image_digest",
        "platform",
        "accelerator",
        "argv",
        "working_dir",
        "inputs",
        "outputs",
        "resource_limits",
        "network_policy",
        "validator_policy",
        "item_ids",
        "parameters"
      ],
      "title": "Assignment",
      "type": "object"
    },
    "AssignmentInput": {
      "additionalProperties": false,
      "properties": {
        "archive": {
          "default": false,
          "title": "Archive",
          "type": "boolean"
        },
        "artifact": {
          "$ref": "#/$defs/Artifact"
        },
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "mount_path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Mount Path",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "mount_path",
        "artifact"
      ],
      "title": "AssignmentInput",
      "type": "object"
    },
    "Output": {
      "additionalProperties": false,
      "properties": {
        "max_bytes": {
          "exclusiveMinimum": 0.0,
          "maximum": 9.223372036854776e+18,
          "title": "Max Bytes",
          "type": "integer"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "max_bytes"
      ],
      "title": "Output",
      "type": "object"
    },
    "Resources": {
      "additionalProperties": false,
      "properties": {
        "cpu_millis": {
          "exclusiveMinimum": 0.0,
          "maximum": 9.223372036854776e+18,
          "title": "Cpu Millis",
          "type": "integer"
        },
        "disk_bytes": {
          "exclusiveMinimum": 0.0,
          "maximum": 9.223372036854776e+18,
          "title": "Disk Bytes",
          "type": "integer"
        },
        "gpu_slots": {
          "default": 0,
          "maximum": 64.0,
          "minimum": 0.0,
          "title": "Gpu Slots",
          "type": "integer"
        },
        "memory_bytes": {
          "exclusiveMinimum": 0.0,
          "maximum": 9.223372036854776e+18,
          "title": "Memory Bytes",
          "type": "integer"
        },
        "vram_bytes": {
          "default": 0,
          "maximum": 9.223372036854776e+18,
          "minimum": 0.0,
          "title": "Vram Bytes",
          "type": "integer"
        }
      },
      "required": [
        "cpu_millis",
        "memory_bytes",
        "disk_bytes"
      ],
      "title": "Resources",
      "type": "object"
    }
  },
  "$ref": "#/$defs/Assignment",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
