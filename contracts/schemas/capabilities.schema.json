{
  "$defs": {
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "cpu_millis": {
          "minimum": 0.0,
          "title": "Cpu Millis",
          "type": "integer"
        },
        "disk_bytes": {
          "minimum": 0.0,
          "title": "Disk Bytes",
          "type": "integer"
        },
        "gpu_slots": {
          "default": 0,
          "maximum": 64.0,
          "minimum": 0.0,
          "title": "Gpu Slots",
          "type": "integer"
        },
        "memory_bytes": {
          "minimum": 0.0,
          "title": "Memory Bytes",
          "type": "integer"
        },
        "vram_bytes": {
          "default": 0,
          "minimum": 0.0,
          "title": "Vram Bytes",
          "type": "integer"
        }
      },
      "required": [
        "cpu_millis",
        "memory_bytes",
        "disk_bytes"
      ],
      "title": "Budget",
      "type": "object"
    },
    "Capabilities": {
      "additionalProperties": false,
      "properties": {
        "allow_on_battery": {
          "default": false,
          "title": "Allow On Battery",
          "type": "boolean"
        },
        "arch": {
          "enum": [
            "amd64",
            "arm64"
          ],
          "title": "Arch",
          "type": "string"
        },
        "cpu_logical": {
          "exclusiveMinimum": 0.0,
          "maximum": 1024.0,
          "title": "Cpu Logical",
          "type": "integer"
        },
        "disk_available_bytes": {
          "minimum": 0.0,
          "title": "Disk Available Bytes",
          "type": "integer"
        },
        "gpus": {
          "items": {
            "$ref": "#/$defs/GPU"
          },
          "maxItems": 64,
          "title": "Gpus",
          "type": "array"
        },
        "image_digests": {
          "items": {
            "maxLength": 256,
            "pattern": "^[a-z0-9][a-z0-9./:_-]*@sha256:[a-f0-9]{64}$",
            "type": "string"
          },
          "maxItems": 128,
          "title": "Image Digests",
          "type": "array"
        },
        "memory_available_bytes": {
          "minimum": 0.0,
          "title": "Memory Available Bytes",
          "type": "integer"
        },
        "offered_budget": {
          "$ref": "#/$defs/Budget"
        },
        "os": {
          "enum": [
            "linux",
            "windows",
            "darwin"
          ],
          "title": "Os",
          "type": "string"
        },
        "power_state": {
          "enum": [
            "ac",
            "battery",
            "unknown"
          ],
          "title": "Power State",
          "type": "string"
        },
        "preflight_revision": {
          "exclusiveMinimum": 0.0,
          "title": "Preflight Revision",
          "type": "integer"
        },
        "runtime": {
          "$ref": "#/$defs/Runtime"
        }
      },
      "required": [
        "os",
        "arch",
        "cpu_logical",
        "memory_available_bytes",
        "disk_available_bytes",
        "runtime",
        "power_state",
        "offered_budget",
        "preflight_revision"
      ],
      "title": "Capabilities",
      "type": "object"
    },
    "GPU": {
      "additionalProperties": false,
      "properties": {
        "cuda_verified": {
          "title": "Cuda Verified",
          "type": "boolean"
        },
        "driver": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Driver",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "vendor": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Vendor",
          "type": "string"
        },
        "vram_bytes": {
          "minimum": 0.0,
          "title": "Vram Bytes",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "vendor",
        "vram_bytes",
        "driver",
        "cuda_verified"
      ],
      "title": "GPU",
      "type": "object"
    },
    "Runtime": {
      "additionalProperties": false,
      "properties": {
        "healthy": {
          "title": "Healthy",
          "type": "boolean"
        },
        "type": {
          "const": "docker",
          "title": "Type",
          "type": "string"
        },
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "type",
        "version",
        "healthy"
      ],
      "title": "Runtime",
      "type": "object"
    }
  },
  "$ref": "#/$defs/Capabilities",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
