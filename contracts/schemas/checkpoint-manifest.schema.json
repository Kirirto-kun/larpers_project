{
  "$defs": {
    "CheckpointFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "size_bytes",
        "sha256"
      ],
      "title": "CheckpointFile",
      "type": "object"
    },
    "CheckpointManifest": {
      "additionalProperties": false,
      "properties": {
        "compatibility_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Compatibility Digest",
          "type": "string"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/CheckpointFile"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Files",
          "type": "array"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "compatibility_digest",
        "files"
      ],
      "title": "CheckpointManifest",
      "type": "object"
    }
  },
  "$ref": "#/$defs/CheckpointManifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
