{
  "$defs": {
    "OutputRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "artifact_id"
      ],
      "title": "OutputRef",
      "type": "object"
    },
    "ResultManifest": {
      "additionalProperties": false,
      "properties": {
        "compute_ms": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Compute Ms"
        },
        "item_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10000,
          "title": "Item Ids",
          "type": "array"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/OutputRef"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Outputs",
          "type": "array"
        }
      },
      "required": [
        "outputs"
      ],
      "title": "ResultManifest",
      "type": "object"
    }
  },
  "$ref": "#/$defs/ResultManifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
